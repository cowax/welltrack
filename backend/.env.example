# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://welltrack:welltrack@localhost:5432/welltrack"

# JWT
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# SMTP (for password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="WellTrack <noreply@example.com>"

# Frontend base URL (used in reset-password email links)
FRONTEND_URL=http://localhost:5173
